{
  "name": "wexample/php-api",
  "description": "Generic JSON API client for PHP, built on Guzzle",
  "type": "library",
  "license": "MIT",
  "version": "5.0.0",
  "authors": [
    {
      "name": "Wexample",
      "email": "contact@wexample.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.5",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "Wexample\\PhpApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\PhpApi\\Tests\\": "tests/"
    }
  }
}